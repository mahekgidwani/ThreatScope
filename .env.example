# Copy to .env and replace every change-me value. .env is git-ignored.
APP_ENV=dev
LOG_LEVEL=INFO
INGEST_API_KEY=change-me
POSTGRES_USER=threatscope
POSTGRES_PASSWORD=change-me
POSTGRES_DB=threatscope
POSTGRES_HOST=db
POSTGRES_PORT=5432
POSTGRES_HOST_PORT=5432
MAX_METADATA_BYTES=65536
# Optional full SQLAlchemy URL. It replaces the connection built from POSTGRES_*, but POSTGRES_USER,
# POSTGRES_PASSWORD and POSTGRES_DB are still required. Treated as a secret.
# DATABASE_URL=
# Optional, used by the adapters in backend/integrations (defaults shown). They also need INGEST_API_KEY.
# THREATSCOPE_API_URL=http://127.0.0.1:8000
# THREATSCOPE_TIMEOUT_SECONDS=10
# The dashboard (dashboard/, run on the host) also reads INGEST_API_KEY, but only to create and edit incidents.
# Without it the dashboard is read-only. It never needs the database settings.
